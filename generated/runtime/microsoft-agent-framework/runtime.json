{
  "native_types": {
    "coordinator": "agent_framework._agents.Agent",
    "worker": "agent_framework._agents.Agent"
  },
  "observations": [
    {
      "agent": "coordinator",
      "data": {
        "mechanism": "agent-as-tool-isolated-session",
        "subagent": "worker",
        "task": "Analyze this."
      },
      "kind": "subagent-started"
    },
    {
      "agent": "coordinator",
      "data": {
        "result": "worker result",
        "subagent": "worker"
      },
      "kind": "subagent-returned"
    },
    {
      "agent": "coordinator",
      "data": {
        "result": "coordinator used worker result"
      },
      "kind": "runtime-output"
    }
  ],
  "output": "coordinator used worker result",
  "probe": "delegation",
  "target": "microsoft-agent-framework"
}
